{
	"version": 3,
	"routes": [
		{
			"src": ".*",
			"continue": true,
			"transforms": [
				{
					"type": "request.query",
					"op": "delete",
					"target": {
						"key": "__pathname"
					}
				}
			]
		},
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "/_app/immutable/.+",
			"status": 404,
			"headers": {
				"cache-control": "no-store"
			},
			"continue": false
		},
		{
			"src": "^/?(?:/__data.json)?$",
			"dest": "/"
		},
		{
			"src": "^/auth/login/?(?:/__data.json)?$",
			"dest": "/auth/login"
		},
		{
			"src": "^/auth/register/?(?:/__data.json)?$",
			"dest": "/auth/register"
		},
		{
			"src": "^/courses/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/courses/[courseId]"
		},
		{
			"src": "^/courses/([^/]+?)/contents/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/courses/[courseId]/contents/[contentId]"
		},
		{
			"src": "^/profile/?(?:/__data.json)?$",
			"dest": "/profile"
		},
		{
			"src": "^/users/?(?:/__data.json)?$",
			"dest": "/users"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {}
}